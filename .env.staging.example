# Staging .env — the review copy of the site.
#
# Copy this to the staging folder on the server as `.env` and fill in the four
# marked values. It never leaves your machine through git, and deploy-staging.sh
# refuses to upload any .env, so staging and production can never share one.
#
#   scp .env.staging.example publicationmart:domains/beta.publicationmart.com/public_html/.env
#   ssh publicationmart "cd domains/beta.publicationmart.com/public_html && php artisan key:generate"

APP_NAME=PublicationMart
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://beta.publicationmart.com

# ── Database ───────────────────────────────────────────────────────────────
# A SEPARATE database, created in hPanel. 2.0 adds no migrations, so a copy of
# the production database imports directly and staging shows real-looking data.
# Never point this at the production database: staging is meant to be clicked
# through freely, and every click would be writing to the real one.
#
#   Export from live:  mysqldump -u LIVE_USER -p LIVE_DB > dump.sql
#   Import to staging: mysql -u STAGING_USER -p STAGING_DB < dump.sql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=            # <- the staging database
DB_USERNAME=            # <- its own user
DB_PASSWORD=            # <- its own password

# ── Mail ───────────────────────────────────────────────────────────────────
# Written to storage/logs instead of sent. Staging holds a copy of the real
# author list; a test signup must not email 690 real people.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=staging@publicationmart.com
MAIL_FROM_NAME="PublicationMart (staging)"

# ── Payments ───────────────────────────────────────────────────────────────
# Left blank deliberately. APP_ENV=staging also blocks checkout in
# PhonePeService, so this is belt and braces: a demo click cannot move money.
PHONEPE_ENV=UAT
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=

# ── Analytics ──────────────────────────────────────────────────────────────
# Blank so a walkthrough does not appear in your real traffic figures.
GA_MEASUREMENT_ID=
FB_PIXEL_ID=

# ── Broadcasting ───────────────────────────────────────────────────────────
# Staging can share these or leave them blank; nothing depends on them for a
# design review.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
