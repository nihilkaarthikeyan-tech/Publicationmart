# ==========================================
# ROOT .htaccess — PublicationMart
# ==========================================

# --- DISABLE LITESPEED PAGE CACHE ---
<IfModule LiteSpeed>
    CacheDisable public /
</IfModule>

# --- COMPRESSION (Faster Downloads) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# --- HTTPS + ROUTE TO PUBLIC FOLDER ---
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- BLOCK PRIVATE DOCUMENTS (must run BEFORE the rewrite to /public) ---
    # Manuscripts and paid-service customer files were downloadable by anyone
    # holding the URL. They are served only via authenticated routes now.
    # Covers/images stay public because pages render them.
    RewriteRule ^(public/)?storage/interiors/ - [F,L]
    RewriteRule ^(public/)?storage/professional-manuscripts/ - [F,L]
    RewriteRule ^(public/)?storage/books/ - [F,L]
    RewriteRule ^(public/)?storage/audiobooks/ - [F,L]

    # Route all requests to /public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>