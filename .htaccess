# ==========================================
# ROOT .htaccess — PublicationMart
# ==========================================

# --- DISABLE LITESPEED PAGE CACHE ---
<IfModule LiteSpeed>
    CacheDisable public /
</IfModule>

# --- COMPRESSION (Faster Downloads) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# --- HTTPS + ROUTE TO PUBLIC FOLDER ---
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Route all requests to /public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>